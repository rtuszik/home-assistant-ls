{
    "name": "home-assistant-ls",
    "version": "0.0.2-beta",
    "description": "Language Server for Home Assistant configuration files",
    "main": "dist/server.js",
    "bin": {
        "home-assistant-language-server": "bin/home-assistant-ls"
    },
    "files": [
        "dist/**/*",
        "bin/**/*",
        "README.md"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p ./ && ts-node src/language-service/src/schemas/generateSchemas.ts && mkdir -p dist/language-service/src/schemas && cp src/language-service/src/schemas/mappings.json dist/language-service/src/schemas/ && cp -R src/language-service/src/schemas/json dist/language-service/src/schemas/",
        "schema": "ts-node src/language-service/src/schemas/generateSchemas.ts",
        "watch": "tsc --watch",
        "test": "node test/file-accessor.js && node test/lsp-smoke.js",
        "prepublishOnly": "aube run build"
    },
    "keywords": [
        "home-assistant",
        "language-server",
        "lsp",
        "yaml",
        "nvim",
        "neovim",
        "vim"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": ""
    },
    "dependencies": {
        "@vscode/l10n": "^0.0.18",
        "axios": "^1.10.0",
        "home-assistant-js-websocket": "^9.5.0",
        "uuid": "^13.0.0",
        "vscode-json-languageservice": "^5.6.1",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-protocol": "3.17.5",
        "vscode-languageserver-textdocument": "^1.0.12",
        "vscode-uri": "3.1.0",
        "ws": "8.18.3",
        "yaml": "2.8.0",
        "yaml-language-server": "1.19.2"
    },
    "devDependencies": {
        "@types/node": "24.10.1",
        "@types/uuid": "^11.0.0",
        "@types/ws": "8.18.1",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "typescript-json-schema": "0.67.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
